rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Uploaded resumes for analysis (existing folder pattern: resumes/{uid}/...)
    match /resumes/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Generated files with TTL (PDFs from analysis, cover letter, company analysis)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Support ticket attachments. Ownership is encoded in the path
    // (tickets/{userId}/{ticketId}/...) so the rule doesn't need cross-service
    // queries into Firestore — simpler and more robust across plans/configs.
    // Reads are allowed for any authenticated user (admins need to view too;
    // the download URL itself carries an access token).
    match /tickets/{userId}/{ticketId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
