rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isAdmin()
        || (isOwner(userId)
            && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isOwner(userId) || isAdmin();

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Devices subcollection
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Saved items (resumes + generated PDFs with 10h TTL)
      match /savedItems/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.type in ['resume', 'resume-analysis', 'company-analysis', 'cover-letter'];
        allow update: if isOwner(userId)
          && resource.data.type == 'resume'
          && request.resource.data.type == 'resume'
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt;
        allow delete: if isOwner(userId);
      }
    }

    // Stats - readable by all authenticated, writable by authenticated users
    match /stats/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Admins collection - only readable by the admin themselves or superadmins
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if isAdmin();
    }

    // Verification codes - authenticated users can create/read/delete their own
    match /verificationCodes/{codeId} {
      allow read, write: if isAuthenticated();
    }

    // Market data - read only for authenticated users
    match /market/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Feedbacks - users create their own, only admins read/delete
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 4000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Support tickets — created via /api/support/tickets (privileged server
    // generates the 5-digit id with collision retry). Once created, the owner
    // can update only the activity counters when sending a message; the admin
    // route handles closing. Direct status changes from the client are
    // forbidden.
    match /tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update: if
        // Admin can update anything (close, etc.) — server route enforces shape.
        isAdmin()
        // Owner can only touch activity fields and the post-creation images
        // upload (immediately after the API created the doc).
        || (isOwner(resource.data.userId)
            && resource.data.status == "open"
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastMessageAt', 'lastMessageBy', 'messageCount', 'updatedAt', 'images']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId)
                    || isAdmin();
        allow create: if
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.status == "open"
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 4000
          && (
            // Owner replying
            (isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId)
              && request.resource.data.senderRole == 'user')
            // Admin replying
            || (isAdmin() && request.resource.data.senderRole == 'admin')
          );
        allow update, delete: if false;
      }
    }
  }
}
