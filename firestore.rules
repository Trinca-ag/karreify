rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        // Campos server-authoritative (saldo, bônus, contadores grátis, passe)
        // nunca vêm do client no cadastro — o setDoc de signup cria com
        // credits:0 e sem esses campos. Bloquear injeção no create impede
        // auto-crédito e bypass do limite grátis logo na criação da conta.
        && (!('credits' in request.resource.data) || request.resource.data.credits == 0)
        && !('welcomeCreditsGranted' in request.resource.data)
        && !('freeSearchCount' in request.resource.data)
        && !('freeSearchLastAt' in request.resource.data)
        && !('jobsPassExpiresAt' in request.resource.data)
        && !('jobsPassType' in request.resource.data)
        // Indicação é 100% server-side: a atribuição (referredBy) e o código
        // próprio (referralCode) são gravados pelo Admin SDK no fluxo de
        // boas-vindas. Bloquear no create impede o usuário se autoatribuir um
        // indicador, forjar o próprio código ou burlar o anti-autoindicação.
        && !('referredBy' in request.resource.data)
        && !('referralCode' in request.resource.data);
      // Pelo client o dono só edita campos de perfil (profile/page.tsx). Saldo,
      // flag de boas-vindas, contadores de busca grátis e passe são gravados
      // exclusivamente pelo Admin SDK (que ignora estas regras). Restringir o
      // update a um allowlist impede o client de se auto-creditar, resetar o
      // limite grátis (freeSearchCount/freeSearchLastAt) ou estender o passe.
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['displayName', 'photoURL', 'autoSaveDocuments', 'updatedAt']));
      allow delete: if isOwner(userId) || isAdmin();

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        // Criação é 100% server-side via Admin SDK (credits-server, webhook
        // AbacatePay, buy-pass, welcome, gate de tester). Bloquear o create do
        // client impede forjar transações — poluir o ledger, o gate de tester
        // e a listagem admin de passes (collectionGroup em feature=='jobs-pass').
        allow create: if false;
        allow update: if isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Devices subcollection
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Saved items (resumes + generated PDFs with 10h TTL)
      match /savedItems/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.type in ['resume', 'resume-analysis', 'company-analysis', 'cover-letter'];
        allow update: if isOwner(userId)
          && resource.data.type == 'resume'
          && request.resource.data.type == 'resume'
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt;
        allow delete: if isOwner(userId);
      }

      // Notifications — owner can read, mark as read, and delete their own.
      // Creation is server-only via Admin SDK so the source can't be spoofed.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['read']);
        allow delete: if isOwner(userId);
      }
    }

    // Stats — readable by any authenticated user (dashboards). Writes are
    // exclusively server-side via the Admin SDK (e.g. deductCreditsServer)
    // so the totals can't be tampered with from the browser.
    match /stats/{document} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Admins collection - only readable by the admin themselves or superadmins
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if isAdmin();
    }

    // Verification codes — server-only. All flows (device verification,
    // password reset, email change, admin login) go through API routes that
    // use the Admin SDK. Direct client access leaks codes across accounts.
    match /verificationCodes/{codeId} {
      allow read, write: if false;
    }

    // Auth attempts — contadores do rate-limit escalonado (lib/auth-rate-limit.ts).
    // Gravado e lido exclusivamente pelo Admin SDK nos endpoints de auth.
    // Client-side nunca precisa ver — proibimos acesso direto.
    match /authAttempts/{attemptId} {
      allow read, write: if false;
    }

    // Market data - read only for authenticated users
    match /market/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Feedbacks - users create their own, only admins read/delete
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 4000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Pending payments — fluxo Abacate Pay. Criação/atualização é 100%
    // server-side via Admin SDK (/api/payments/checkout e
    // /api/webhooks/abacatepay). Usuário pode ler os próprios pra
    // acompanhar status; admins podem ler tudo. Sem write do client.
    match /pendingPayments/{paymentId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Support tickets — created via /api/support/tickets (privileged server
    // generates the 5-digit id with collision retry). Once created, the owner
    // can update only the activity counters when sending a message; the admin
    // route handles closing. Direct status changes from the client are
    // forbidden.
    match /tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update: if
        // Admin can update anything (close, etc.) — server route enforces shape.
        isAdmin()
        // Owner can only touch activity fields and the post-creation images
        // upload (immediately after the API created the doc).
        || (isOwner(resource.data.userId)
            && resource.data.status == "open"
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastMessageAt', 'lastMessageBy', 'messageCount', 'updatedAt', 'images']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // Messages are writable only via the server route
        // (/api/support/tickets/{id}/messages) which uses the Admin SDK and
        // also fires the notification + email when an admin replies.
        allow read: if isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId)
                    || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // ==================== Sistema de Indicação / Carteira ====================
    // Todos os registros financeiros (indicações, comissões, carteira, saques,
    // reembolsos e auditoria) são gravados EXCLUSIVAMENTE pelo Admin SDK nas
    // rotas de API. O client só LÊ os próprios registros; nunca cria, edita ou
    // apaga. Idempotência e integridade ficam nas transações server-side.

    // Vínculo indicador↔indicado. Leitura pelas duas pontas envolvidas ou admin.
    match /referrals/{referralId} {
      allow read: if isAuthenticated()
        && (resource.data.referrerUid == request.auth.uid
            || resource.data.referredUid == request.auth.uid
            || isAdmin());
      allow create, update, delete: if false;
    }

    // Resolução código→uid. Só o servidor (Admin SDK) lê/grava — expor a
    // listagem permitiria enumerar códigos de indicação de outros usuários.
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // Carteira de dinheiro (separada dos créditos/moedas). Server-only.
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      // Ledger imutável de movimentações da carteira.
      match /walletTransactions/{txId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // Comissões. O indicador lê as próprias; admin lê todas.
    match /commissions/{commissionId} {
      allow read: if isAuthenticated()
        && (resource.data.referrerUid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Saques PIX. Solicitados via rota de API (não há write direto do client),
    // como acontece com os tickets. Dono lê os próprios; admin lê tudo.
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Reembolsos. Solicitados via rota de API. Dono lê os próprios; admin tudo.
    match /refunds/{refundId} {
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Auditoria financeira — somente admin lê; nunca gravável/legível pelo client.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
